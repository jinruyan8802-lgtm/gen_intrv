# Text model
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
TEXT_MODEL=gpt-4o

# TTS (optional, defaults to text model credentials)
TTS_API_KEY=
TTS_BASE_URL=
TTS_INTERVIEWER_VOICE=alloy
TTS_CANDIDATE_VOICE=nova
TTS_PROVIDER=openai          # openai or minimax
TTS_MODEL=speech-01-hd       # MiniMax model name (only used when TTS_PROVIDER=minimax)

# Generation
LANGUAGE=zh
QUESTION_COUNT=10
TTS_CONCURRENCY=3

# Dedup
DEDUP_TFIDF_THRESHOLD=0.5
